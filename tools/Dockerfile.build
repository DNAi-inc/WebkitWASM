FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config git curl tar xz-utils unzip python3 \
    python3-yaml ruby perl bison gperf ca-certificates fonts-dejavu-core fonts-dejavu-extra \
    autoconf automake libtool gettext patch rsync file ripgrep && \
    rm -rf /var/lib/apt/lists/*
RUN useradd --uid 501 --gid 20 --create-home --shell /bin/bash builder
USER builder
WORKDIR /workspace
ENV BIB_JOBS=2
CMD ["bash"]
