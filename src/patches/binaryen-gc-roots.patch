@@ -69,6 +72,21 @@
   // main entry point
 
   void doWalkFunction(Function* func) {
+    if (encodedValues) {
+      // A previous argument or expression result may remain on the Wasm
+      // operand stack while a nested call collects. Materialize those values
+      // as locals before computing liveness; spilling original locals alone
+      // cannot expose them. Do not optimize them back onto the operand stack.
+      PassRunner preparation(getModule(), getPassOptions());
+      preparation.setIsNested(true);
+      preparation.add("flatten");
+      // Flatten alone can exceed VM local-count limits in the large CLoop.
+      // Reuse non-overlapping local slots without re-stacking expressions.
+      preparation.add("simplify-locals-nonesting");
+      preparation.add("reorder-locals");
+      preparation.add("coalesce-locals");
+      preparation.runOnFunction(func);
+    }
     Super::doWalkFunction(func);
     spillPointers();
   }
@@ -84,10 +102,18 @@
     // we only care about possible pointers
     auto* func = getFunction();
     PointerMap pointerMap;
+    Index spillSize = 0;
     for (Index i = 0; i < func->getNumLocals(); i++) {
-      if (func->getLocalType(i) == pointerType) {
-        auto offset = pointerMap.size() * pointerType.getByteSize();
-        pointerMap[i] = offset;
+      auto type = func->getLocalType(i);
+      // JSC's wasm32 JSValue also carries cell payloads in i64/f64 locals.
+      // Native register scanning sees those bits; spill them here as well.
+      if (type == pointerType ||
+          (encodedValues && (type == Type::i64 || type == Type::f64 ||
+                             type == Type::f32 || type == Type::v128))) {
+        auto size = type.getByteSize();
+        spillSize = (spillSize + size - 1) & ~(size - 1);
+        pointerMap[i] = spillSize;
+        spillSize += size;
       }
